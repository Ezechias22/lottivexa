ARG APP=tenant-web
FROM node:22-alpine AS build
ARG APP
ARG NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/${APP} apps/${APP}
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @lottivexa/${APP} build
FROM node:22-alpine AS runtime
ARG APP
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 APP_NAME=$APP
RUN addgroup -S lottivexa && adduser -S lottivexa -G lottivexa
WORKDIR /app
COPY --from=build --chown=lottivexa:lottivexa /app/node_modules ./node_modules
COPY --from=build --chown=lottivexa:lottivexa /app/apps/${APP} ./app
USER lottivexa
EXPOSE 3000
CMD ["sh","-c","./node_modules/.bin/next start ./app -p 3000"]
