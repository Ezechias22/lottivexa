FROM node:22-bookworm-slim AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY services/printing/package.json services/printing/package.json
COPY packages/printer-sdk/package.json packages/printer-sdk/package.json
RUN pnpm install --frozen-lockfile --filter @lottivexa/printing-worker...
COPY services/printing services/printing
COPY packages/printer-sdk packages/printer-sdk
USER node
CMD ["pnpm","--filter","@lottivexa/printing-worker","start"]
