FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY services/api services/api
COPY packages/database packages/database
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @lottivexa/database generate && pnpm --filter @lottivexa/api build
FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=4000
RUN addgroup -S lottivexa && adduser -S lottivexa -G lottivexa
WORKDIR /app
COPY --from=build --chown=lottivexa:lottivexa /app/node_modules ./node_modules
COPY --from=build --chown=lottivexa:lottivexa /app/services/api/dist ./services/api/dist
COPY --from=build --chown=lottivexa:lottivexa /app/packages/database ./packages/database
USER lottivexa
EXPOSE 4000
CMD ["node","services/api/dist/main.js"]
