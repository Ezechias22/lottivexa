NODE_ENV=production
PORT=4000
POSTGRES_DB=lottivexa
POSTGRES_USER=lottivexa_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://lottivexa_app:replace@postgres:5432/lottivexa?schema=public
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_URL=redis://:replace@redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
PLATFORM_DOMAIN=example.com
TENANT_CNAME_TARGET=tenants.example.com
ACME_EMAIL=operations@example.com
ACME_DNS_ADAPTER_URL=https://dns-provider-bridge.invalid/acme
ACME_DNS_ADAPTER_KEY=replace-with-dns-provider-secret
CORS_ORIGINS=https://admin.example.com,https://app.example.com
PASSWORD_RESET_WEB_URL=https://example.com/reset-password
NEXT_PUBLIC_PASSWORD_RESET_URL=https://example.com/reset-password
SWAGGER_ENABLED=false
BACKUP_RETENTION_DAYS=30
STORAGE_PATH=/data/storage
PITR_RETENTION_DAYS=7
JOBS_ENABLED=true
JOBS_INTERVAL_MS=15000
SUBSCRIPTION_GRACE_DAYS=3
EMAIL_ADAPTER_URL=https://notification-provider.example/email
EMAIL_ADAPTER_KEY=replace-with-provider-secret
SMS_ADAPTER_URL=https://notification-provider.example/sms
SMS_ADAPTER_KEY=replace-with-provider-secret
PUSH_ADAPTER_URL=https://notification-provider.example/push
PUSH_ADAPTER_KEY=replace-with-provider-secret
