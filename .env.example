NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lottivexa:lottivexa_dev@localhost:5432/lottivexa?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
TICKET_CANCELLATION_SECONDS=300
PRINT_API_URL=http://host.docker.internal:4000/api/v1
PRINT_TENANT=tenant-slug
PRINT_USERNAME=printer-worker
PRINT_PASSWORD=replace-with-worker-password
PRINT_WORKER_ID=branch-01-worker
PRINT_POLL_MS=1500
PRINT_BATCH_SIZE=5
# Set only for a one-shot physical test print:
# PRINT_TEST_PRINTER_ID=printer-uuid
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PLATFORM_DOMAIN=localhost
TENANT_CNAME_TARGET=tenants.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PASSWORD_RESET_WEB_URL=http://localhost:3003/reset-password
NEXT_PUBLIC_PASSWORD_RESET_URL=http://localhost:3003/reset-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
JOBS_ENABLED=true
JOBS_INTERVAL_MS=15000
# LotteryResultsFeed.com: secrets stay on the API server, never in web/mobile clients.
LOTTERY_RESULTS_FEED_BASE_URL=https://www.lotteryresultsfeed.com/api
LOTTERY_RESULTS_FEED_TOKEN=
# Map real provider lottery IDs and draw types to the installed Haiti catalog.
# Example shape only; replace IDs/times with those returned by your provider account.
LOTTERY_RESULTS_FEED_BINDINGS=[]
LOTTERY_RESULTS_FEED_POLL_ENABLED=false
LOTTERY_RESULTS_FEED_POLL_MS=900000
# Provider-neutral HTTPS delivery bridges. Leave unset to retain/retry jobs as FAILED.
EMAIL_ADAPTER_URL=
EMAIL_ADAPTER_KEY=
SMS_ADAPTER_URL=
SMS_ADAPTER_KEY=
PUSH_ADAPTER_URL=
PUSH_ADAPTER_KEY=
